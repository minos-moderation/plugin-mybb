<?xml version="1.0" encoding="UTF-8"?>
<!--
  The live run on a real MyBB 1.8.41 forum: only through bin/verify-mybb-1841.sh (and the
  live.yml workflow), never part of the plain `vendor/bin/phpunit`.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheResult="false"
         executionOrder="default"
         stopOnFailure="true">
    <testsuites>
        <testsuite name="live">
            <file>LiveForumTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
